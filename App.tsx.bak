import React, { useEffect, Suspense } from 'react';
import { HashRouter, Routes, Route, useLocation, Navigate } from 'react-router-dom';
import { AnimatePresence } from 'framer-motion';
import { Layout } from './src/features/layout/Layout';
import { HomePage } from './src/features/home/HomePage';
import { ProjectDetailPage } from './src/features/work/ProjectDetailPage';
import { BlogPostPage } from './src/features/blog/BlogPostPage';
import { ServiceDetailPage } from './src/features/services/ServiceDetailPage';
import { WorkPage } from './src/features/work/WorkPage';
import { ServicesPage } from './src/features/services/ServicesPage';
import { AboutPage } from './src/features/about/AboutPage';
import { ContactPage } from './src/features/contact/ContactPage';
import { BlogPage } from './src/features/blog/BlogPage';

const LoadingScreen = () => (
  <div className="fixed inset-0 bg-black flex items-center justify-center z-[100]">
    <div className="w-8 h-8 border-4 border-blue-500 border-t-transparent rounded-full animate-spin"></div>
  </div>
);

const AnimatedRoutes = () => {
  const location = useLocation();

  return (
    <AnimatePresence mode="wait">
      <Routes location={location} key={location.pathname}>
        <Route path="/" element={<HomePage />} />
        
        {/* Detail Routes */}
        <Route path="/work/:slug" element={<ProjectDetailPage />} />
        <Route path="/services/:slug" element={<ServiceDetailPage />} />
        <Route path="/blog/:slug" element={<BlogPostPage />} />
        
        {/* Section Routes - Redirect to Home with Hash */}
        <Route path="/work" element={<Navigate to="/#work" replace />} />
        <Route path="/services" element={<Navigate to="/#services" replace />} />
        <Route path="/blog" element={<Navigate to="/#blog" replace />} />
        <Route path="/about" element={<Navigate to="/#about" replace />} />
        <Route path="/contact" element={<Navigate to="/#contact" replace />} />
        
        {/* Default Catch-all */}
        <Route path="*" element={<Navigate to="/" replace />} />
      </Routes>
    </AnimatePresence>
  );
};

const ScrollController = () => {
  const { pathname } = useLocation();

  useEffect(() => {
    window.scrollTo(0, 0);
  }, [pathname]);

  return null;
};

function App() {
  useEffect(() => {
    if ('scrollRestoration' in window.history) {
      window.history.scrollRestoration = 'manual';
    }
  }, []);

  return (
    <Suspense fallback={<LoadingScreen />}>
      <HashRouter>
        <ScrollController />
        <Layout>
          <AnimatedRoutes />
        </Layout>
      </HashRouter>
    </Suspense>
  );
}

export default App;